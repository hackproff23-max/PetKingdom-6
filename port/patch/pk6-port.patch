@@ -88,6 +88,10 @@ android {
             versionName = props.getValue('MIDlet-Version')
             resValue 'string', 'app_name', midletName
             midletArchivesBaseName = apkName
+            // Port: so ARM (celulares reais). Tira x86/x86_64 e economiza ~5 MB de libs nativas.
+            ndk {
+                abiFilters 'armeabi-v7a', 'arm64-v8a'
+            }
             proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'),
                     'proguard-midlet.pro', 'proguard-common.pro'
         }
@@ -161,7 +165,48 @@ def getMidletManifestProperties() {
     return mf.mainAttributes
 }
 
+// ---------------------------------------------------------------------------
+// PORT (flavor "midlet"): embute o jogo (app/port/PetKingdom6.jar) no APK.
+//
+// 1) compilePortTool   compila tools/port/InstrumentJar.java + AndroidProducer (ASM),
+//                      o mesmo conversor que o app usa ao importar um .jar.
+// 2) instrumentGameJar aplica a instrumentacao nas classes e copia os recursos
+//                      (imagens, .mid, .ui...) para build/port/game-instrumented.jar.
+// 3) o jar resultante entra como dependencia do flavor midlet; o D8/R8 converte as
+//    classes para dex e o AGP empacota os recursos no APK.
+// ---------------------------------------------------------------------------
+configurations {
+    portTool
+}
+
+def portJarIn = file('port/PetKingdom6.jar')
+def portOutDir = layout.buildDirectory.dir('port').get().asFile
+def portToolDir = new File(portOutDir, 'tool')
+def portJarOut = new File(portOutDir, 'game-instrumented.jar')
+
+tasks.register('compilePortTool', JavaCompile) {
+    source fileTree(dir: "${rootDir}/dexlib/src/main/java/org/microemu/android/asm", include: '*.java')
+    source "${rootDir}/tools/port/InstrumentJar.java"
+    classpath = configurations.portTool
+    destinationDirectory.set(portToolDir)
+    options.release.set(11)
+}
+
+tasks.register('instrumentGameJar', JavaExec) {
+    dependsOn 'compilePortTool'
+    classpath = configurations.portTool + files(portToolDir)
+    mainClass.set('InstrumentJar')
+    args portJarIn.absolutePath, portJarOut.absolutePath
+    inputs.file portJarIn
+    outputs.file portJarOut
+}
+
 dependencies {
+    portTool 'org.ow2.asm:asm:9.11'
+    midletImplementation(files(portJarOut)) {
+        builtBy 'instrumentGameJar'
+    }
+
     def roomVersion = '2.6.1' // api 19
     def cameraxVersion = "1.6.2"
     def autoServiceVersion = "1.1.1"
diff --git a/app/proguard-midlet.pro b/app/proguard-midlet.pro
index e7c2d7e..2009651 100644
--- a/app/proguard-midlet.pro
+++ b/app/proguard-midlet.pro
@@ -38,4 +38,23 @@
 
 # -keep public class mypackage.MyClass
 # -keep public interface mypackage.MyInterface
-# -keep public class * implements mypackage.MyInterface
\ No newline at end of file
+# -keep public class * implements mypackage.MyInterface
+
+# ---- Port Pet Kingdom 6 ------------------------------------------------------
+# O jogo usa Class.forName / reflexao em alguns pontos (CWATools, WMASender), e as
+# classes dele sao pequenas: nao encolher nem ofuscar os pacotes do jogo.
+-keep class game.** { *; }
+-keep class CWA2DAPI.** { *; }
+-keep class CWAEvent.** { *; }
+-keep class CWAUI.** { *; }
+-keep class com.zy.** { *; }
+-keep class com.sina.** { *; }
+-keep class XConnection { *; }
+-keep class XMessage { *; }
+
+# APIs opcionais do J2ME que o jogo referencia mas o app pode nao embutir.
+-dontwarn javax.wireless.**
+-dontwarn javax.microedition.**
+-dontwarn com.nokia.**
+-dontwarn com.siemens.**
+-ignorewarnings
